{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "resolveJsonModule": true,
    "types": ["chrome", "vite/client"],
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src", "tests", "*.ts"]
}
